{
  "name": "campusconnect-fullstack",
  "version": "1.0.0",
  "type": "module",
  "description": "CampusConnect – Your College, Your Community. Fullstack React & Node.js Platform",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "start:prod": "npm run build && npm --prefix backend start"
  },
  "keywords": [
    "campusconnect",
    "college",
    "students",
    "react",
    "nodejs",
    "express"
  ],
  "author": "CampusConnect Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
